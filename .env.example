# Javni URL stranice (za povratne linkove plaćanja i mailove)
PUBLIC_SITE_URL=http://localhost:4321

# Admin (/admin) – lozinka i tajna za potpis kolačića
ADMIN_PASSWORD=demo
SESSION_SECRET=promijeni-me-na-dug-nasumican-string

# Kartično plaćanje: monri | mock (SAMO demo!) | prazno = kartica isključena, samo bankovni transfer.
# Na produkciji nikad ne stavljati "mock" – gost bi mogao sam "platiti".
PAYMENT_PROVIDER=

# Monri WebPay (dobije se od banke nakon ugovora)
MONRI_ENV=test
MONRI_AUTHENTICITY_TOKEN=
MONRI_KEY=
MONRI_CURRENCY=EUR

# Bankovni transfer (prikazuje se gostu)
BANK_NAME=
BANK_IBAN=
BANK_SWIFT=
BANK_HOLDER=bosnien-endurotours

# E-mail (Resend). Bez ključa se mailovi spremaju u data/outbox/ (za demo)
RESEND_API_KEY=
MAIL_FROM="bosnien-endurotours <buchung@bosnien-endurotours.com>"
ADMIN_NOTIFY_EMAIL=office@bosnien-endurotours.com

# TODO(confirm-with-client): WhatsApp broj
WHATSAPP_NUMBER=436601877869
