---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  img?: ImageMetadata;
}
const { eyebrow, title, intro, img } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-ink text-white">
  {
    img && (
      <>
        <Image src={img} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" class="absolute inset-0 -z-10 size-full object-cover opacity-60" />
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink via-ink/70 to-ink/20" />
      </>
    )
  }
  <div class:list={['wrap', img ? 'py-20 sm:py-28' : 'pt-12 pb-10']}>
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-2 max-w-3xl text-5xl font-bold sm:text-7xl">{title}</h1>
    {intro && <p class="mt-4 max-w-2xl text-lg text-white/80">{intro}</p>}
    <slot />
  </div>
</section>
