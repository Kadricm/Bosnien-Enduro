---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/images/logos/logo-bosnien-endurotours.png';
import { whatsapp } from '../lib/config';
import { seasonLabel } from '../lib/departures';
import { prefix, t, type Lang } from '../i18n';
import { content, social } from '../content';

interface Props {
  title: string;
  lang: Lang;
  description?: string;
  /** Auf Seiten mit fixer Preisleiste unten (mobil) den WhatsApp-Button höher setzen. */
  raiseFab?: boolean;
  /** Header transparent über dem Hero (Startseite), wird beim Scrollen dunkel. */
  overlay?: boolean;
}
const { title, lang, raiseFab = false, overlay = false } = Astro.props;
const T = t(lang);
const H = content(lang).header;
const description = Astro.props.description ?? T.meta.description;
const p = prefix(lang);
const wa = whatsapp();
const year = new Date().getFullYear();

// Gleiche Seite in der anderen Sprache
const path = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const other: Lang = lang === 'de' ? 'en' : 'de';
const otherUrl = (other === 'en' ? `/en${path === '/' ? '' : path}` || '/en' : path) + Astro.url.search;
const site = Astro.site?.origin ?? '';
const here = path.replace(/\/$/, '') || '/';
const active = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));

const nav = [
  { href: '/termine', label: H.dates },
  { href: '/verleih', label: H.rental },
  { href: '/hotel', label: H.hotel },
  { href: '/ueber-uns', label: H.about },
  { href: '/galerie', label: H.gallery },
];
const tours = [
  { href: '/touren/5-tage-enduro-tour', label: H.tour5, sub: H.tour5sub },
  { href: '/touren/8-tage-enduro-tour', label: H.tour8, sub: H.tour8sub },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Demo: nicht indexieren -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="de" href={site + path} />
    <link rel="alternate" hreflang="en" href={site + (path === '/' ? '/en' : '/en' + path)} />
    <link rel="alternate" hreflang="x-default" href={site + path} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#141414" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:rounded focus:bg-signal focus:px-3 focus:py-2 focus:text-ink">Skip to content</a>

    <header id="site-header" data-overlay={overlay ? '' : undefined} class="group/h fixed inset-x-0 top-0 z-40 text-white transition-colors duration-300">
      <!-- Topbar -->
      <div class="hidden border-b border-white/10 bg-ink text-xs text-white/70 transition-all duration-300 md:block group-data-[scrolled]/h:-mt-9 group-data-[overlay]/h:bg-transparent group-data-[scrolled]/h:opacity-0">
        <div class="wrap flex h-9 items-center justify-between gap-4">
          <p class="flex items-center gap-3">
            <span>{H.location}</span><span class="text-white/30">|</span><span class="text-signal">{H.season(seasonLabel())}</span>
          </p>
          <div class="flex items-center gap-4">
            <a class="hover:text-white" href="tel:+436601877869">+43 660 1877869</a>
            <a class="hover:text-white" href="mailto:office@bosnien-endurotours.com">office@bosnien-endurotours.com</a>
            <span class="flex items-center gap-2.5">
              <a href={social.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="hover:text-white"><svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></svg></a>
              <a href={social.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="hover:text-white"><svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.5 1.6-1.5h1.7V4.4c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1v2.4H7.7V14h2.7v8h3.1z"/></svg></a>
              <a href={social.youtube} target="_blank" rel="noopener" aria-label="YouTube" class="hover:text-white"><svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.7 15.1V8.9L15.5 12l-5.8 3.1z"/></svg></a>
            </span>
            <a href={otherUrl} hreflang={other} class="rounded border border-white/25 px-1.5 py-0.5 font-semibold text-white hover:border-signal hover:text-signal" aria-label={T.nav.switchLabel}>{T.nav.switchCode}</a>
          </div>
        </div>
      </div>

      <!-- Hauptleiste -->
      <div class="relative bg-ink/95 backdrop-blur transition-colors duration-300 group-data-[overlay]/h:bg-transparent group-data-[overlay]/h:backdrop-blur-none group-data-[scrolled]/h:bg-ink/95 group-data-[scrolled]/h:backdrop-blur group-data-[scrolled]/h:shadow-lg">
        <div class="absolute inset-x-0 bottom-0 h-0.5 bg-gradient-to-r from-signal via-signal/40 to-transparent opacity-0 transition-opacity group-data-[scrolled]/h:opacity-100 group-[:not([data-overlay])]/h:opacity-100"></div>
        <div class="wrap flex h-[72px] items-center justify-between gap-6">
          <a href={p + '/'} class="shrink-0" aria-label={T.nav.home}>
            <Image src={logo} alt="bosnien-endurotours" width={220} class="h-12 w-auto drop-shadow-[0_2px_6px_rgba(0,0,0,.5)]" loading="eager" />
          </a>

          <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
            <div class="group/dd relative">
              <button type="button" class:list={['flex items-center gap-1 px-3 py-2 font-display text-lg font-semibold uppercase tracking-wide hover:text-signal', active('/touren') && 'text-signal']} aria-haspopup="true">
                {H.tours}
                <svg viewBox="0 0 20 20" class="size-4 transition-transform group-hover/dd:rotate-180" fill="currentColor" aria-hidden="true"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z" /></svg>
              </button>
              <div class="invisible absolute top-full left-0 w-80 translate-y-2 pt-2 opacity-0 transition-all group-hover/dd:visible group-hover/dd:translate-y-0 group-hover/dd:opacity-100 group-focus-within/dd:visible group-focus-within/dd:translate-y-0 group-focus-within/dd:opacity-100">
                <div class="overflow-hidden rounded-lg bg-white text-ink shadow-2xl ring-1 ring-ink/10">
                  {
                    tours.map((x) => (
                      <a href={p + x.href} class="flex items-center gap-3 border-b border-ink/5 px-4 py-3 hover:bg-sand">
                        <span class="h-10 w-1 rounded bg-signal" />
                        <span>
                          <span class="block font-display text-xl font-bold uppercase">{x.label}</span>
                          <span class="text-sm text-ink/60">{x.sub}</span>
                        </span>
                      </a>
                    ))
                  }
                  <a href={p + '/#touren'} class="block bg-sand px-4 py-2.5 text-sm font-semibold text-signal-dark hover:underline">{H.allTours} →</a>
                </div>
              </div>
            </div>
            {
              nav.map((n) => (
                <a href={p + n.href} class:list={['relative px-3 py-2 font-display text-lg font-semibold uppercase tracking-wide hover:text-signal', active(n.href) && 'text-signal']} aria-current={active(n.href) ? 'page' : undefined}>
                  {n.label}
                </a>
              ))
            }
          </nav>

          <div class="flex items-center gap-2">
            <a href={p + '/buchen'} class="hidden flex-col items-center rounded-md bg-signal px-5 py-1.5 text-ink shadow-[0_6px_20px_-6px_rgba(255,106,19,.7)] transition hover:-translate-y-0.5 hover:bg-signal-dark sm:flex">
              <span class="font-display text-lg leading-tight font-bold uppercase">{H.cta}</span>
              <span class="text-[11px] leading-tight font-medium">{H.ctaSub}</span>
            </a>
            <a href={otherUrl} hreflang={other} class="rounded border border-white/25 px-2 py-1 text-xs font-semibold md:hidden" aria-label={T.nav.switchLabel}>{T.nav.switchCode}</a>
            <button type="button" id="menu-open" class="flex size-11 items-center justify-center rounded-md hover:bg-white/10 lg:hidden" aria-label={H.menu} aria-expanded="false" aria-controls="mobile-menu">
              <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" stroke-linecap="round" /></svg>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Mobiles Menü -->
    <div id="mobile-menu" class="fixed inset-0 z-50 hidden flex-col overflow-y-auto bg-ink text-white data-[open]:flex" role="dialog" aria-modal="true" aria-label={H.menu}>
      <div class="wrap flex h-[72px] shrink-0 items-center justify-between">
        <Image src={logo} alt="" width={180} class="h-11 w-auto" loading="eager" />
        <button type="button" id="menu-close" class="flex size-11 items-center justify-center rounded-md hover:bg-white/10" aria-label={H.close}>
          <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
        </button>
      </div>
      <nav class="wrap flex flex-1 flex-col gap-1 py-6" aria-label="Mobile">
        <p class="eyebrow mb-1">{H.tours}</p>
        {tours.map((x) => <a href={p + x.href} class="py-1.5 hover:text-signal"><span class="block font-display text-3xl font-bold uppercase">{x.label}</span><span class="text-sm text-white/50">{x.sub}</span></a>)}
        <span class="my-3 h-px bg-white/10" />
        {nav.map((n) => <a href={p + n.href} class:list={['py-1.5 font-display text-3xl font-bold uppercase hover:text-signal', active(n.href) && 'text-signal']}>{n.label}</a>)}
        <a href={p + '/buchen'} class="btn-primary mt-6">{H.cta}</a>
        <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/70">
          <a href="tel:+436601877869">+43 660 1877869</a>
          <a href={`https://wa.me/${wa}`}>WhatsApp</a>
          <a href={otherUrl} hreflang={other} class="font-semibold text-white">{T.nav.switchLabel}</a>
        </div>
      </nav>
    </div>

    <main id="main" class:list={['flex-1', !overlay && 'pt-[72px] md:pt-[108px]']}><slot /></main>

    <footer class="bg-ink text-white/70">
      <div class="wrap grid gap-8 py-12 text-sm sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <Image src={logo} alt="" width={160} class="mb-3 h-10 w-auto" />
          <p>{T.footer.tagline}</p>
          <div class="mt-4 flex gap-3">
            <a href={social.instagram} target="_blank" rel="noopener" class="hover:text-signal">Instagram</a>
            <a href={social.facebook} target="_blank" rel="noopener" class="hover:text-signal">Facebook</a>
            <a href={social.youtube} target="_blank" rel="noopener" class="hover:text-signal">YouTube</a>
          </div>
        </div>
        <div>
          <p class="mb-2 font-display text-lg uppercase text-white">{H.tours}</p>
          {tours.map((x) => <p><a class="hover:text-signal" href={p + x.href}>{x.label}</a></p>)}
          {nav.map((n) => <p><a class="hover:text-signal" href={p + n.href}>{n.label}</a></p>)}
        </div>
        <div>
          <p class="mb-2 font-display text-lg uppercase text-white">{T.footer.contact}</p>
          <p>Paloč bb., 70280 Gornji Vakuf-Uskoplje, BiH</p>
          <p><a class="hover:text-signal" href="tel:+436601877869">+43 660 1877869</a></p>
          <p><a class="hover:text-signal" href="mailto:office@bosnien-endurotours.com">office@bosnien-endurotours.com</a></p>
        </div>
        <div>
          <p class="mb-2 font-display text-lg uppercase text-white">{T.footer.legal}</p>
          <p>{T.footer.legalLinks}</p>
          <p class="mt-4 text-white/40">© {year} bosnien-endurotours · {T.footer.demo}</p>
        </div>
      </div>
    </footer>

    <a
      href={`https://wa.me/${wa}`}
      target="_blank"
      rel="noopener"
      class:list={[raiseFab ? 'bottom-28 lg:bottom-4' : 'bottom-4']}
      class="fixed right-4 z-30 flex size-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform hover:scale-105 print:hidden"
      aria-label={T.footer.whatsapp}
    >
      <svg viewBox="0 0 24 24" class="size-7" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.81 11.81 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41"></path></svg>
    </a>

    <script>
      const header = document.getElementById('site-header')!;
      const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const menu = document.getElementById('mobile-menu')!;
      const openBtn = document.getElementById('menu-open')!;
      const setMenu = (open: boolean) => {
        menu.toggleAttribute('data-open', open);
        openBtn.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
        if (open) (document.getElementById('menu-close') as HTMLElement).focus();
      };
      openBtn.addEventListener('click', () => setMenu(true));
      document.getElementById('menu-close')!.addEventListener('click', () => setMenu(false));
      document.addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));
    </script>
  </body>
</html>
