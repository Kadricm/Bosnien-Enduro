---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import DepartureRow from '../../../components/DepartureRow.astro';
import { listDepartures } from '../../../lib/departures';
import { settings, tours } from '../../../data/seed';
import { eur } from '../../../lib/format';
import { langFromParam, prefix, t } from '../../../i18n';
import { content } from '../../../content';
import hero5 from '../../../assets/images/gruppe/grupa-pogled.jpg';
import hero8 from '../../../assets/images/hero/hero-ramsko-jezero.jpg';
import side5 from '../../../assets/images/huette-essen/koliba-vatra.jpg';
import side8 from '../../../assets/images/gruppe/grupa-iznad-jezera.jpg';

const lang = langFromParam(Astro.params.lang);
const tour = tours.find((x) => x.slug === Astro.params.tour);
if (!lang || !tour) return new Response(null, { status: 404 });
const T = t(lang);
const C = content(lang).tours;
const page = C[tour.id];
const p = prefix(lang);
const deps = listDepartures({ tour: tour.id, lang }).filter((d) => d.status === 'free' || d.status === 'few').slice(0, 5);
---

<Base title={page.title} lang={lang} description={page.intro}>
  <PageHero eyebrow={`${C.eyebrow} · ${T.home.ridingDays(tour.ridingDays)}`} title={T.tourName[tour.id]} intro={page.intro} img={tour.id === 5 ? hero5 : hero8}>
    <div class="mt-8 flex flex-wrap items-end gap-6">
      <div>
        <p class="text-sm text-white/60">{C.own}</p>
        <p class="font-display text-5xl font-bold">{eur(tour.priceOwnBike, lang)}</p>
      </div>
      <div>
        <p class="text-sm text-white/60">{C.rental}</p>
        <p class="font-display text-5xl font-bold text-signal">{eur(tour.priceRentalBike, lang)}</p>
      </div>
      <a href={`${p}/buchen?tour=${tour.id}`} class="btn-primary">{C.book}</a>
    </div>
  </PageHero>

  <section class="wrap grid gap-10 py-16 lg:grid-cols-[1fr_380px]">
    <div class="space-y-12">
      <div>
        <h2 class="text-4xl font-bold">{C.programH}</h2>
        <ol class="mt-6 space-y-0 border-l-2 border-signal/30">
          {
            page.program.map(([h, d]) => (
              <li class="relative pb-8 pl-8 last:pb-0">
                <span class="absolute top-1.5 -left-[9px] size-4 rounded-full border-4 border-sand bg-signal" />
                <h3 class="text-2xl font-bold">{h}</h3>
                <p class="mt-1 text-ink/75">{d}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div class="card">
          <h3 class="text-2xl font-bold">{C.inclH}</h3>
          <ul class="mt-3 space-y-2 text-sm">{C.incl.map((x) => <li class="flex gap-2"><span class="text-ok">✓</span>{x}</li>)}</ul>
        </div>
        <div class="card">
          <h3 class="text-2xl font-bold">{C.exclH}</h3>
          <ul class="mt-3 space-y-2 text-sm">{C.excl.map((x) => <li class="flex gap-2"><span class="text-ink/40">–</span>{x}</li>)}</ul>
        </div>
      </div>

      <div class="card">
        <h3 class="text-2xl font-bold">{C.extrasH}</h3>
        <ul class="mt-3 space-y-2 text-sm text-ink/80">
          <li>{C.single(settings.singleRoomPerNight)}</li>
          <li>{C.gear(settings.gearPerDay)}</li>
          <li>{C.transfer}</li>
        </ul>
      </div>
    </div>

    <aside class="space-y-6 lg:sticky lg:top-32 lg:self-start">
      <Image src={tour.id === 5 ? side5 : side8} alt="" widths={[400, 760]} sizes="(min-width:1024px) 380px, 100vw" class="aspect-[4/3] w-full rounded-xl object-cover" />
      <div class="card">
        <h3 class="text-2xl font-bold">{C.datesH}</h3>
        <ul class="mt-2">{deps.map((d) => <DepartureRow d={d} lang={lang} tour={tour.id} />)}</ul>
        <a href={`${p}/termine?tour=${tour.id}`} class="mt-3 inline-block font-semibold text-signal-dark hover:underline">{C.allDates} →</a>
      </div>
    </aside>
  </section>
</Base>
