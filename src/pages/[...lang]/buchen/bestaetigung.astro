---
import Base from '../../../layouts/Base.astro';
import { getBooking } from '../../../lib/booking';
import { read } from '../../../lib/db';
import { bankDetails } from '../../../lib/config';
import { eur, fmtDate } from '../../../lib/format';
import { langFromParam, prefix, t } from '../../../i18n';

const lang = langFromParam(Astro.params.lang);
if (!lang) return new Response(null, { status: 404 });
const T = t(lang);
const D = T.done;
const p = prefix(lang);

const ref = Astro.url.searchParams.get('ref') ?? '';
const token = Astro.url.searchParams.get('token') ?? '';
const b = getBooking(ref, token);
if (!b) return new Response(T.err.notFound, { status: 404 });
const dep = read((db) => db.departures.find((d) => d.code === b.departureCode)!);
const bank = bankDetails();
const q = `ref=${encodeURIComponent(ref)}&token=${token}`;
const state = b.status === 'confirmed' ? 'confirmed' : b.status === 'pending_payment' ? (b.paymentMethod === 'bank' ? 'bank' : 'card') : 'expired';
const money = (n: number) => eur(n, lang);
---

<Base title={D.title(b.ref)} lang={lang}>
  <section class="wrap max-w-2xl py-12">
    <p class="eyebrow">{D.booking} {b.ref}</p>
    {
      state === 'confirmed' && (
        <>
          <h1 class="mt-2 text-5xl font-bold">{D.confirmedH}</h1>
          <p class="mt-3 text-lg text-ink/80">{D.confirmedText(b.contact.email)}</p>
        </>
      )
    }
    {
      state === 'bank' && (
        <>
          <h1 class="mt-2 text-5xl font-bold">{D.bankH}</h1>
          <p class="mt-3 text-lg text-ink/80">{D.bankText(fmtDate(b.expiresAt!.slice(0, 10)))}</p>
          <dl class="card mt-6 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
            <dt class="text-ink/60">{D.amount}</dt>
            <dd class="font-display text-2xl font-bold">{money(b.quote.deposit)}</dd>
            <dt class="text-ink/60">{D.holder}</dt>
            <dd>{bank.holder}</dd>
            <dt class="text-ink/60">{D.bank}</dt>
            <dd>{bank.name}</dd>
            <dt class="text-ink/60">IBAN</dt>
            <dd class="font-mono">{bank.iban}</dd>
            <dt class="text-ink/60">SWIFT/BIC</dt>
            <dd class="font-mono">{bank.swift}</dd>
            <dt class="text-ink/60">{D.purpose}</dt>
            <dd class="font-mono font-bold">{b.ref}</dd>
          </dl>
          <p class="mt-2 text-xs text-ink/60">{D.swiftNote}</p>
        </>
      )
    }
    {
      state === 'card' && (
        <>
          <h1 class="mt-2 text-5xl font-bold">{D.cardH}</h1>
          <a href={`${p}/buchen/bezahlen?${q}`} class="btn-primary mt-6">
            {D.payNow}
          </a>
        </>
      )
    }
    {
      state === 'expired' && (
        <>
          <h1 class="mt-2 text-5xl font-bold">{D.expiredH}</h1>
          <p class="mt-3 text-ink/80">{D.expiredText}</p>
          <a href={`${p}/buchen`} class="btn-primary mt-6">
            {D.rebook}
          </a>
        </>
      )
    }

    <div class="card mt-6 text-sm">
      <p class="font-display text-2xl font-bold uppercase">{T.tourName[b.tourId]}</p>
      <p class="text-ink/60">{D.date} {dep.code} · {fmtDate(dep.start)} – {fmtDate(dep.end)}</p>
      <p class="mt-3">{b.participants.map((x) => `${x.firstName} ${x.lastName}`).join(', ')}</p>
      <ul class="mt-4 space-y-1.5 border-t border-ink/10 pt-4">
        {
          b.quote.lines.map((l) => (
            <li class="flex justify-between gap-3">
              <span class="text-ink/70">{l.label}</span>
              <span class="shrink-0 whitespace-nowrap">{money(l.amount)}</span>
            </li>
          ))
        }
        <li class="flex justify-between border-t border-ink/10 pt-2 font-semibold"><span>{D.total}</span><span>{money(b.quote.total)}</span></li>
        <li class="flex justify-between"><span>{D.deposit} {b.paymentStatus === 'paid' ? D.paid : ''}</span><span>{money(b.quote.deposit)}</span></li>
        <li class="flex justify-between"><span>{D.rest}</span><span>{money(b.quote.balance)}</span></li>
      </ul>
    </div>
  </section>
</Base>
