---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { langFromParam } from '../../i18n';
import { content } from '../../content';

const lang = langFromParam(Astro.params.lang);
if (!lang) return new Response(null, { status: 404 });
const C = content(lang).gallery;

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/{galerie,gelaende,huette-essen,gruppe}/*.jpg', { eager: true });
const imgs = await Promise.all(
  Object.keys(files)
    .sort()
    .map(async (k) => ({ src: files[k].default, big: (await getImage({ src: files[k].default, width: 1600 })).src })),
);
---

<Base title={C.title} lang={lang} description={C.intro}>
  <PageHero eyebrow={C.eyebrow} title={C.h1} intro={C.intro} />

  <section class="wrap py-10">
    <ul class="columns-2 gap-3 md:columns-3 lg:columns-4">
      {
        imgs.map((im, i) => (
          <li class="mb-3 break-inside-avoid">
            <a href={im.big} data-i={i} class="block overflow-hidden rounded-lg">
              <Image src={im.src} alt="" widths={[400, 600]} sizes="(min-width:1024px) 25vw, (min-width:768px) 33vw, 50vw" class="w-full transition-transform duration-500 hover:scale-105" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <dialog id="lb" class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-ink/95">
    <div class="flex h-dvh w-dvw items-center justify-center p-4">
      <img id="lb-img" alt="" class="max-h-full max-w-full rounded-lg object-contain" />
    </div>
    <button type="button" data-close class="fixed top-4 right-4 flex size-12 items-center justify-center rounded-full bg-white/10 text-3xl text-white hover:bg-white/20" aria-label={C.close}>×</button>
    <button type="button" data-step="-1" class="fixed top-1/2 left-3 flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-3xl text-white hover:bg-white/20" aria-label={C.prev}>‹</button>
    <button type="button" data-step="1" class="fixed top-1/2 right-3 flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-3xl text-white hover:bg-white/20" aria-label={C.next}>›</button>
  </dialog>
</Base>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-i]')];
  const lb = document.getElementById('lb') as HTMLDialogElement;
  const img = document.getElementById('lb-img') as HTMLImageElement;
  let cur = 0;
  const show = (i: number) => {
    cur = (i + links.length) % links.length;
    img.src = links[cur].href;
  };
  links.forEach((a, i) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      show(i);
      lb.showModal();
    }),
  );
  lb.querySelector('[data-close]')!.addEventListener('click', () => lb.close());
  lb.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => show(cur + Number(b.dataset.step))));
  lb.addEventListener('click', (e) => e.target === lb.firstElementChild && lb.close());
  document.addEventListener('keydown', (e) => {
    if (!lb.open) return;
    if (e.key === 'ArrowRight') show(cur + 1);
    if (e.key === 'ArrowLeft') show(cur - 1);
  });
</script>
